        org.openjfx/javafx-controls {:mvn/version "21.0.5"}
        org.openjfx/javafx-base {:mvn/version "21.0.5"}
        org.openjfx/javafx-graphics {:mvn/version "21.0.5"}
        org.openjfx/javafx-fxml {:mvn/version "21.0.5"}

        ;; Krrō 核心
        top.kzre/krro-core {:mvn/version "0.1.0"}
        top.kzre/krro-ui-core {:mvn/version "0.1.0"}

